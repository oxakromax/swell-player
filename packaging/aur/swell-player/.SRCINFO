pkgbase = swell-player
	pkgdesc = Fast, lightweight native TIDAL client with bit-perfect Hi-Res playback (GTK 4 + libadwaita)
	pkgver = 1.0.0
	pkgrel = 1
	url = https://github.com/oxakromax/swell-player
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	makedepends = cargo
	depends = glib2
	depends = glibc
	depends = graphene
	depends = gst-plugins-base
	depends = gst-plugins-good
	depends = gstreamer
	depends = gtk4
	depends = hicolor-icon-theme
	depends = libadwaita
	depends = libgcc
	depends = pango
	depends = sqlite
	optdepends = org.freedesktop.secrets: keyring to stay signed in (gnome-keyring, kwallet, keepassxc...)
	optdepends = gst-libav: AAC playback for the Low and High qualities
	optdepends = xdg-desktop-portal: open links in the browser and keep the system awake while playing
