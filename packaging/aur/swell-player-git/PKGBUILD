# Maintainer: oxakromax <oxakromax at hotmail dot com>

pkgname=swell-player-git
_pkgname=swell-player
pkgver=1.1.0
pkgrel=1
pkgdesc="Fast, lightweight native TIDAL client with bit-perfect Hi-Res playback (GTK 4 + libadwaita, development version)"
arch=('x86_64' 'aarch64')
url="https://github.com/oxakromax/swell-player"
license=('GPL-3.0-or-later')
depends=(
  'glib2'
  'glibc'
  'graphene'
  'gst-plugins-base'   # playbin3, audioconvert, volume (loaded at runtime)
  'gst-plugins-good'   # dashdemux2 (Hi-Res DASH), FLAC, MP4, HTTP source
  'gstreamer'
  'gtk4'
  'hicolor-icon-theme'
  'libadwaita'
  'libgcc'
  'pango'
  'sqlite'
)
makedepends=('cargo' 'git')
# lto: makepkg's -flto leaves aws-lc-sys's C objects as undefined symbols at
# link time. debug: the release profile strips the binary, so a -debug
# package would be empty.
options=('!lto' '!debug')
optdepends=(
  'org.freedesktop.secrets: keyring to stay signed in (gnome-keyring, kwallet, keepassxc...)'
  'gst-libav: AAC playback for the Low and High qualities'
  'xdg-desktop-portal: open links in the browser and keep the system awake while playing'
)
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  # 1.0.0.r12.gabc1234 from the latest v* tag; before the first tag,
  # 0.r<commits>.g<hash>, so the first tagged version sorts higher.
  if git describe --long --tags --abbrev=7 --match 'v*' >/dev/null 2>&1; then
    git describe --long --tags --abbrev=7 --match 'v*' |
      sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
  else
    printf '0.r%s.g%s' \
      "$(git rev-list --count HEAD)" \
      "$(git rev-parse --short=7 HEAD)"
  fi
}

prepare() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen --release
}

package() {
  cd "$_pkgname"
  make install PREFIX=/usr DESTDIR="$pkgdir" CARGO_TARGET_DIR=target
}
