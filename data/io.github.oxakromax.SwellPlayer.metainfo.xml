<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.oxakromax.SwellPlayer</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Swell</name>
  <summary>Listen to TIDAL in a native app</summary>
  <description>
    <p>
      Swell is a lightweight, native TIDAL client for Linux built with GTK 4
      and libadwaita. It streams up to Hi-Res Lossless, keeps your collection,
      playlists and mixes one click away, and follows your desktop's light or
      dark style and accent colour.
    </p>
    <p>Swell is not affiliated with TIDAL. An active TIDAL subscription is needed.</p>
  </description>
  <launchable type="desktop-id">io.github.oxakromax.SwellPlayer.desktop</launchable>
  <developer id="io.github.oxakromax">
    <name>Swell contributors</name>
  </developer>
  <content_rating type="oars-1.1"/>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>
  <provides>
    <binary>swell-player</binary>
  </provides>
  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
    <category>Player</category>
  </categories>
  <releases>
    <release version="0.1.0" date="2026-10-17"/>
  </releases>
</component>
