#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Regenerates po/swell.pot, the translation template, from the sources.

Scans src/**/*.rs for the literals passed to tr("…"), trn("…", "…") and
n_("…"), with the same rules as the `every_string_is_translated` test in
src/i18n.rs: the literal may start on the line after the parenthesis,
identifiers that merely end in the marker (`from_str(`) are skipped, and
src/i18n.rs itself is left out.

It also picks up the msgids that reach tr()/trn() through a variable, which
that test cannot see:
- plural helpers called as `counted(n, "{n} track", "{n} tracks")` and
  `unit(n, "{n} hour", "{n} hours")`;
- sort options: `("id", "Label", true|false)` tuples (`SortOption`).

Usage:
    po/update-pot           write po/swell.pot
    po/update-pot --check   exit with status 1 if po/swell.pot is out of date

Then merge it into a catalogue with gettext's msgmerge:
    msgmerge --update --backup=none --no-fuzzy-matching po/es.po po/swell.pot

Needs Python 3.8 or later and nothing else.
"""

import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SOURCES = ROOT / "src"
OUTPUT = ROOT / "po" / "swell.pot"
MARKERS = ("tr(", "trn(", "n_(")
# Helpers whose second and third arguments are a singular and a plural msgid.
PLURAL_HELPERS = ("counted(", "unit(")
# `SortOption` tuples: ("id", "Label", bool); the label is the msgid.
SORT_OPTION = re.compile(
    r'\(\s*"[a-z_]+"\s*,\s*"((?:[^"\\]|\\.)*)"\s*,\s*(?:true|false)\s*\)'
)

HEADER = """\
# Translation template for Swell.
# This file is distributed under the same license as Swell (GPL-3.0-or-later).
# Generated by po/update-pot: do not edit by hand.
#
# Placeholders in braces ({name}, {n}...) are replaced after translating:
# keep them unchanged, in whatever order the language needs.
#
#, fuzzy
msgid ""
msgstr ""
"Project-Id-Version: swell-player\\n"
"Report-Msgid-Bugs-To: https://github.com/oxakromax/swell-player/issues\\n"
"Language: \\n"
"MIME-Version: 1.0\\n"
"Content-Type: text/plain; charset=UTF-8\\n"
"Content-Transfer-Encoding: 8bit\\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\\n"
"""


def literal(text, start):
    """The Rust string literal whose contents begin at text[start] (just
    after the opening quote), unescaped, with `\\` line continuations
    removed, and the index just past its closing quote; None if unclosed."""
    out = []
    i = start
    while i < len(text):
        c = text[i]
        i += 1
        if c == '"':
            return "".join(out), i
        if c != "\\":
            out.append(c)
            continue
        if i >= len(text):
            return None
        e = text[i]
        i += 1
        if e == "n":
            out.append("\n")
        elif e == "t":
            out.append("\t")
        elif e == "\n":
            while i < len(text) and text[i].isspace():
                i += 1
        else:
            out.append(e)
    return None


def skip_space(text, i):
    while i < len(text) and text[i].isspace():
        i += 1
    return i


def is_ident(c):
    return c.isalnum() or c == "_"


def line_of(source, index):
    return source.count("\n", 0, index) + 1


def string_at(source, i):
    """The literal at source[i] (after optional whitespace) and the index
    just past it, or None."""
    i = skip_space(source, i)
    if not source.startswith('"', i):
        return None
    return literal(source, i + 1)


def plural_pair(source, i):
    """Two comma-separated literals starting at source[i], or None."""
    first = string_at(source, i)
    if first is None:
        return None
    i = skip_space(source, first[1])
    if not source.startswith(",", i):
        return None
    second = string_at(source, i + 1)
    if second is None:
        return None
    return first[0], second[0]


def skip_argument(source, i):
    """The index after the comma that ends the argument starting at
    source[i], skipping nested brackets and strings; None if the call ends
    first."""
    depth = 0
    while i < len(source):
        c = source[i]
        if c == '"':
            parsed = literal(source, i + 1)
            if parsed is None:
                return None
            i = parsed[1]
            continue
        if c in "([{":
            depth += 1
        elif c in ")]}":
            if depth == 0:
                return None
            depth -= 1
        elif c == "," and depth == 0:
            return i + 1
        i += 1
    return None


def calls(source, marker):
    """(index just after the marker, line) for each `marker` that is not
    the tail of a longer identifier."""
    at = source.find(marker)
    while at != -1:
        if at == 0 or not is_ident(source[at - 1]):
            yield at + len(marker), line_of(source, at)
        at = source.find(marker, at + 1)


def add(entries, msgid, plural, rel, line):
    key = (msgid, plural is not None)
    entry = entries.setdefault(key, {"plural": plural, "refs": []})
    entry["refs"].append((rel, line))


def scan(path, rel, entries):
    source = path.read_text(encoding="utf-8")
    for marker in MARKERS:
        for i, line in calls(source, marker):
            if marker == "trn(":
                pair = plural_pair(source, i)
                if pair is not None:
                    add(entries, pair[0], pair[1], rel, line)
                continue
            parsed = string_at(source, i)
            if parsed is not None:
                add(entries, parsed[0], None, rel, line)
    for helper in PLURAL_HELPERS:
        for i, line in calls(source, helper):
            i = skip_argument(source, i)
            pair = plural_pair(source, i) if i is not None else None
            if pair is not None:
                add(entries, pair[0], pair[1], rel, line)
    for match in SORT_OPTION.finditer(source):
        msgid = literal(match.group(1) + '"', 0)[0]
        add(entries, msgid, None, rel, line_of(source, match.start()))


def quote(text):
    """A PO string: one line, or one line per "\\n" for multi-line text."""
    escaped = text.replace("\\", "\\\\").replace('"', '\\"').replace("\t", "\\t")
    lines = escaped.split("\n")
    if len(lines) == 1:
        return f'"{escaped}"'
    parts = [line + "\\n" for line in lines[:-1]]
    if lines[-1]:
        parts.append(lines[-1])
    return '""\n' + "\n".join(f'"{part}"' for part in parts)


def generate():
    entries = {}
    for path in sorted(SOURCES.rglob("*.rs")):
        if path.name != "i18n.rs":
            scan(path, path.relative_to(ROOT).as_posix(), entries)
    clashes = sorted(
        msgid for (msgid, is_plural) in entries if is_plural and (msgid, False) in entries
    )
    if clashes:
        sys.exit(
            "used both as a plain and as a plural msgid (gettext allows one): "
            + ", ".join(repr(m) for m in clashes)
        )
    # In order of first appearance: by file, then by line.
    ordered = sorted(
        entries.items(), key=lambda kv: (min(kv[1]["refs"]), kv[0][0])
    )
    out = [HEADER]
    for (msgid, is_plural), entry in ordered:
        block = [f"#: {path}:{line}" for path, line in sorted(set(entry["refs"]))]
        block.append(f"msgid {quote(msgid)}")
        if is_plural:
            block.append(f"msgid_plural {quote(entry['plural'])}")
            block.append('msgstr[0] ""')
            block.append('msgstr[1] ""')
        else:
            block.append('msgstr ""')
        out.append("\n".join(block) + "\n")
    return "\n".join(out), len(ordered)


def main():
    text, count = generate()
    name = OUTPUT.relative_to(ROOT)
    if "--check" in sys.argv[1:]:
        current = OUTPUT.read_text(encoding="utf-8") if OUTPUT.exists() else ""
        if current != text:
            print(f"{name} is out of date: run po/update-pot", file=sys.stderr)
            return 1
        print(f"{name} is up to date ({count} strings)")
        return 0
    OUTPUT.write_text(text, encoding="utf-8")
    print(f"wrote {name} ({count} strings)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
